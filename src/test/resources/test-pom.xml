<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>info.freelibrary</groupId>
  <artifactId>plugin-test</artifactId>
  <version>0.0.0-SNAPSHOT</version>

  <properties>
    <junit.version>4.13.2</junit.version>
    <testLogLevel>DEBUG</testLogLevel>
    <logLevel>DEBUG</logLevel>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <includes>
          <include>freelib-maven_messages.xml</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>info.freelibrary</groupId>
        <artifactId>freelib-maven-plugins</artifactId>
        <version>0.0.0-SNAPSHOT</version>
        <configuration>
          <!-- Test harness throws an NPE without this empty config -->
        </configuration>
        <executions>
          <execution>
            <id>test-generate-mimetypes</id>
            <phase>process-resources</phase>
            <goals>
              <goal>generate-mimetypes</goal>
            </goals>
          </execution>
          <execution>
            <id>test-set-snapshot-url</id>
            <phase>validate</phase>
            <goals>
              <goal>set-snapshot-url</goal>
            </goals>
          </execution>
          <execution>
            <id>test-generate-codes</id>
            <phase>process-resources</phase>
            <goals>
              <goal>generate-codes</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
