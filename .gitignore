# Target really should be in ~/.gitignore, but adding here for the convenience of others
target/

# Build artifact supporting versioned POMs
.flattened-pom.xml

# Ignore files generated by the build
src/main/generated/*
src/test/generated/*
src/test/resources/src/
effective-pom.xml

# Ignore project build tools which are generated on each build;
# we keep Checkstyle and PMD so they can be picked up by Codacy
src/main/tools/eclipse
